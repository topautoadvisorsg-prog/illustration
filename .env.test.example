# Test environment template. Copy to `.env.test` to run integration tests.
#
# Tests NEVER load the repo-root `.env` (see backend/src/env.ts) — that file
# holds production credentials. Anything a test needs goes here instead.
#
# DATABASE_URL must point at a DEDICATED test database. Integration tests
# create and delete projects on every run. Never point this at production.
# Leave it unset and the DB-dependent integration tests skip cleanly.
#
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wildlands_test"
# CONSOLE_PASSWORD="local-test-password"
