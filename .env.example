NODE_ENV=development
# Active project/book the operator scripts run against. REQUIRED — scripts fail
# loudly if unset and never default to a hardcoded book (one-line setup per book).
PROJECT_ID=66c1c69c-2c81-409e-a4b5-bff3f3bb04ba
LOG_LEVEL=info
PORT=8001
HOST=0.0.0.0

ANTHROPIC_API_KEY=your_claude_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-2

REPLICATE_API_TOKEN=your_replicate_token_here
REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan

SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=your_database_url_here

# Cloudflare R2 object storage (S3-compatible, zero egress). When all three secrets
# are set with real values, the backend uses R2 instead of Supabase Storage for
# images/PDFs/files. Leave as placeholders to keep using Supabase. DB stays on Supabase.
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET=project-files

UPSTASH_REDIS_URL=your_upstash_redis_url_here
UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here

SENTRY_DSN_FRONTEND=your_sentry_frontend_dsn_here
SENTRY_DSN_BACKEND=your_sentry_backend_dsn_here

STORAGE_ROOT=backend/storage
