# Wildlands backend — Docker build with Chromium for Paged.js PDF rendering.
# Railway uses Railpack by default (which ignores nixpacks.toml); a Dockerfile
# gives full control and guarantees Chromium + its system libraries are present.
FROM node:20-bookworm-slim

# Chromium + serif fonts + libs. The fonts serve TWO renderers:
#  - Puppeteer/Paged.js (legacy PDF), and
#  - sharp/librsvg (STD-3 print-prep), which rasterizes SVG <text> for badge
#    labels, source lettermarks, and folios. Without an installed serif those
#    would render blank. fonts-liberation → "Liberation Serif", fonts-dejavu-core
#    → "DejaVu Serif" are the fonts named first in TYPOGRAPHY.renderFontFamily.
# fontconfig is pulled in transitively by the font packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium \
      fonts-liberation \
      fonts-dejavu-core \
      fonts-freefont-ttf \
      fontconfig \
      ca-certificates \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

# THE TYPESET INTERIOR FACES, INSTALLED AS SYSTEM FONTS.
#
# Chromium converts any @font-face into Type3 glyph-drawing procedures, which
# print RIPs commonly reject, and embeds proper Type0 CID subsets only for fonts
# in the host font path. Proven both ways in backend/scripts/font-embed-probe.ts
# — a TTF-backed webfont comes out Type3 as well, so the payload format is not
# the variable; webfont-vs-system-font is.
#
# These TTFs are decompressed from the very WOFF2 assets the approved interior
# was set in (backend/scripts/derive-ttf.ts), so glyph outlines and metrics are
# identical and pagination cannot move. font-assets.ts then asks fontconfig what
# is installed and stops emitting @font-face for those families, which is what
# actually flips the embedding.
#
# The build FAILS if the two book faces are not resolvable afterwards: shipping
# an image that silently substitutes Times for EB Garamond is the exact failure
# this whole exercise exists to prevent.
COPY backend/assets/fonts/ttf/*.ttf /usr/local/share/fonts/wildlands/
RUN fc-cache -f \
 && fc-list --format '%{family[0]}\n' | sort -u | grep -qx 'Archivo' \
 && fc-list --format '%{family[0]}\n' | sort -u | grep -qx 'EB Garamond' \
 && echo 'typeset faces installed and resolvable'

# render-pdf.ts resolves Chromium via CHROMIUM_PATH first.
ENV CHROMIUM_PATH=/usr/bin/chromium \
    PUPPETEER_SKIP_DOWNLOAD=true

WORKDIR /app

RUN corepack enable && corepack prepare yarn@1.22.22 --activate

# Dependency layer — cached unless a package.json or the lockfile changes.
COPY package.json yarn.lock ./
COPY shared/package.json ./shared/
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
COPY spikes/package.json ./spikes/
# --production=false forces devDeps (tsc/tsx) even if NODE_ENV=production is set.
RUN yarn install --frozen-lockfile --production=false

# App source + build (shared first, then backend).
COPY . .
RUN yarn workspace @wildlands/shared build \
 && yarn workspace @wildlands/backend build

# Railway injects PORT; the app reads process.env.PORT (default 8001).
CMD ["node", "backend/dist/index.js"]
